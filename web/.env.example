# Web app (Next.js). Copy to .env.local for local dev; on Vercel set these in Project → Settings → Environment Variables.
# Supabase values are added automatically by the Vercel Supabase integration (`vercel env pull`).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# CompanionAI API (Render in production)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Show "Continue with Google" once the Google provider is enabled in Supabase
NEXT_PUBLIC_GOOGLE_AUTH=0
# Playwright only (creates throwaway test users); never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
