# LLM provider: "openai" (default) or "anthropic" (optional; set ANTHROPIC_API_KEY)
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.5
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embeddings: "openai" (default) or "voyage" or "hash" (offline/testing only)
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small
VOYAGE_API_KEY=

# Storage
CHROMA_DIR=.chroma
KB_DIR=data/kb
DATA_DIR=var

# LangSmith tracing (inputs are redacted before tracing)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=companion-ai

# UI -> API
API_URL=http://localhost:8000
